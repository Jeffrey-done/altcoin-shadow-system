# ══════════════════════════════════════════════════════════════════
#  Telegram Bot（必填，用于推送通知和交互指令）
# ══════════════════════════════════════════════════════════════════
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# ══════════════════════════════════════════════════════════════════
#  Binance 合约实盘（可选，默认影子模式不下真实单）
# ══════════════════════════════════════════════════════════════════
# 仅当 config.LIVE_MODE=True 时才会使用
# API 权限勾选要求：
#   ✓ 允许合约交易 (Enable Futures)
#   ✗ 不要勾选 "允许提现" (Enable Withdrawals)
#   ✗ 不要勾选 "允许现货交易" (除非你有其他用途)
# Binance 合约账户需要：
#   - 持仓模式 = 对冲模式 (Hedge Mode)  ← 这是必须的！
#     设置路径：合约 → 偏好设置 → 持仓模式 → 对冲模式
#   - USDT 本位永续合约已开通
# BINANCE_API_KEY=
# BINANCE_SECRET=

# ══════════════════════════════════════════════════════════════════
#  OKX 合约实盘（可选，默认关闭）
# ══════════════════════════════════════════════════════════════════
# 仅当 config.OKX_LIVE_MODE=True 时才会使用
# OKX 合约账户需要：
#   - 持仓模式 = 双向持仓 (long_short_mode)  ← 这是必须的！
#     设置路径：交易 → 设置 → 合约持仓模式 → 双向持仓
#   - USDT 本位永续合约已开通
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=

# ══════════════════════════════════════════════════════════════════
#  Dashboard 访问令牌（可选，留空则关闭鉴权）
# ══════════════════════════════════════════════════════════════════
# 如果 Dashboard 暴露到公网必须设置；长度建议 ≥ 32 字节随机串
# 生成方法：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_TOKEN=

# ══════════════════════════════════════════════════════════════════
#  日志级别（可选，默认 INFO）
# ══════════════════════════════════════════════════════════════════
# LOG_LEVEL=INFO
