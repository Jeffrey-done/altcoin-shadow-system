# ══════════════════════════════════════════════════════════════════
#  Telegram Bot（必填，用于推送通知和交互指令）
# ══════════════════════════════════════════════════════════════════
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# ══════════════════════════════════════════════════════════════════
#  交易所 API 凭证
#  每个交易所是一个独立账户，拥有自己的资金池和配置。
#  凭证优先从 admin_secrets.json 读取（通过 admin panel 管理），
#  环境变量仅作为向后兼容的 fallback。
# ══════════════════════════════════════════════════════════════════

# ── Binance 合约实盘 ─────────────────────────────────────────────
# API 权限勾选要求：
#   ✓ 允许合约交易 (Enable Futures)
#   ✗ 不要勾选 "允许提现" (Enable Withdrawals)
# Binance 合约账户需要：
#   - 持仓模式 = 对冲模式 (Hedge Mode)
#   - USDT 本位永续合约已开通
# BINANCE_API_KEY=
# BINANCE_SECRET=

# ── OKX 合约实盘 ────────────────────────────────────────────────
# OKX 合约账户需要：
#   - 持仓模式 = 双向持仓 (long_short_mode)
#   - USDT 本位永续合约已开通
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=

# ── Gate.io 合约实盘 ────────────────────────────────────────────
# Gate.io 优势：品种覆盖广、Maker 费率低 (0.015%)
# API 申请: https://www.gate.io/myaccount/api_key_manage
# GATE_API_KEY=
# GATE_SECRET=

# ══════════════════════════════════════════════════════════════════
#  每交易所独立账户配置说明 (v3.0)
# ══════════════════════════════════════════════════════════════════
# 每个交易所现在拥有独立的账户配置（不再共享全局参数）：
#   - account_balance: 该交易所的资金池 (USDT)
#   - leverage: 杠杆倍数
#   - default_stake: 单笔保证金 (USDT)
#   - live_mode: 实盘开关（每个交易所独立）
#   - risk: 独立风控参数（max_daily_loss, max_daily_trades, etc.）
#   - compound: 独立复利策略
#   - tp_sl: 独立止盈止损
#
# 配置方式（优先级高→低）：
#   1. Admin Panel 实时修改 → runtime_config.json
#   2. Admin Panel 凭证管理 → admin_secrets.json (settings 字段)
#   3. config/system.yaml → exchanges 段
#   4. config/_defaults.py → EXCHANGE_ACCOUNTS 字典
#
# 推荐通过 Admin Panel 管理所有配置，环境变量仅用于 API 凭证的 fallback。

# ══════════════════════════════════════════════════════════════════
#  Dashboard 访问令牌（可选，留空则关闭鉴权）
# ══════════════════════════════════════════════════════════════════
# 如果 Dashboard 暴露到公网必须设置；长度建议 ≥ 32 字节随机串
# 生成方法：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_TOKEN=

# ══════════════════════════════════════════════════════════════════
#  日志级别（可选，默认 INFO）
# ══════════════════════════════════════════════════════════════════
# LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════════
#  管理员面板 (admin panel)
# ══════════════════════════════════════════════════════════════════
# ADMIN_URL_SECRET 不设置 → 面板不加载，任何路径都 404。
# 必须是一段足够长的随机串（32+ 字节）。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_URL_SECRET=

# 可选：IP 白名单（逗号分隔）
# ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8

# 可选：HTTPS cookie 强制
# DASHBOARD_FORCE_HTTPS_COOKIE=1

# 可选：Flask session 签名密钥
# DASHBOARD_SECRET_KEY=

# ══════════════════════════════════════════════════════════════════
#  Redis 事件总线（推荐，跨进程通信）
# ══════════════════════════════════════════════════════════════════
# Docker Compose 部署时自动设为 redis://redis:6379/0
# 不设置则 EventBus 降级到内存模式（仅单进程有效）
# REDIS_URL=redis://localhost:6379/0

# ══════════════════════════════════════════════════════════════════
#  链上信号（可选，增强 Alpha）
# ══════════════════════════════════════════════════════════════════
# Etherscan API key（免费 5 req/sec）
# ETHERSCAN_API_KEY=

# Whale Alert API key（可选 backup，免费 10 req/min）
# WHALE_ALERT_API_KEY=
