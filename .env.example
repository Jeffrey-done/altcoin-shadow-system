# ══════════════════════════════════════════════════════════════════
#  Telegram Bot（必填，用于推送通知和交互指令）
# ══════════════════════════════════════════════════════════════════
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_chat_id

# ══════════════════════════════════════════════════════════════════
#  Binance 合约实盘（可选，默认影子模式不下真实单）
# ══════════════════════════════════════════════════════════════════
# 仅当 config.LIVE_MODE=True 时才会使用
# API 权限勾选要求：
#   ✓ 允许合约交易 (Enable Futures)
#   ✗ 不要勾选 "允许提现" (Enable Withdrawals)
#   ✗ 不要勾选 "允许现货交易" (除非你有其他用途)
# Binance 合约账户需要：
#   - 持仓模式 = 对冲模式 (Hedge Mode)  ← 这是必须的！
#     设置路径：合约 → 偏好设置 → 持仓模式 → 对冲模式
#   - USDT 本位永续合约已开通
# BINANCE_API_KEY=
# BINANCE_SECRET=

# ══════════════════════════════════════════════════════════════════
#  OKX 合约实盘（可选，默认关闭）
# ══════════════════════════════════════════════════════════════════
# 仅当 config.OKX_LIVE_MODE=True 时才会使用
# OKX 合约账户需要：
#   - 持仓模式 = 双向持仓 (long_short_mode)  ← 这是必须的！
#     设置路径：交易 → 设置 → 合约持仓模式 → 双向持仓
#   - USDT 本位永续合约已开通
# OKX_API_KEY=
# OKX_SECRET=
# OKX_PASSPHRASE=

# ══════════════════════════════════════════════════════════════════
#  Dashboard 访问令牌（可选，留空则关闭鉴权）
# ══════════════════════════════════════════════════════════════════
# 如果 Dashboard 暴露到公网必须设置；长度建议 ≥ 32 字节随机串
# 生成方法：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_TOKEN=

# ══════════════════════════════════════════════════════════════════
#  日志级别（可选，默认 INFO）
# ══════════════════════════════════════════════════════════════════
# LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════════
#  🔐 管理员面板 (admin panel)
# ══════════════════════════════════════════════════════════════════
# 这个面板让你在浏览器里开关实盘、改 API key、改风控参数。
#
# 关键安全设计：ADMIN_URL_SECRET 不设置 → 整个面板不加载，任何路径都 404。
# 互联网扫描器扫不到 /admin /login /config 等常见路径，因为这些路径根本不存在。
#
# 必须是一段足够长的随机串（32+ 字节），面板会挂在 /<这个串>/ 下。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_URL_SECRET=

# 可选：IP 白名单（逗号分隔）。设置后只有列表里的 IP 能访问面板，
# 其它 IP 一律 404（不是 401/403，攻击者连"路径存在"都猜不出）。
# 支持精确 IP；不支持 CIDR。如有多个出口 IP，逐个写。
# ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8

# 可选：当 dashboard 通过 HTTPS 访问时，给 session cookie 加 Secure flag。
# 在 nginx/caddy 强制 HTTPS 的部署里设为 1。
# DASHBOARD_FORCE_HTTPS_COOKIE=1

# 可选：Flask session 签名密钥。不设置每次重启会换一个随机值（登录状态失效）；
# 设置后管理员登录状态能跨重启保留。建议也是 32+ 字节随机。
# DASHBOARD_SECRET_KEY=

# ══════════════════════════════════════════════════════════════════
#  Gate.io 合约实盘（可选，扩展品种覆盖 + 备用执行）
# ══════════════════════════════════════════════════════════════════
# Gate.io 优势：品种覆盖广（比 Binance 多 200+ 小币永续）、Maker 费率低 (0.015%)
# 用途：1) Binance 没上的小币  2) 费率交叉验证  3) 备用执行  4) 跨所套利探索
# API 申请: https://www.gate.io/myaccount/api_key_manage
# GATE_API_KEY=
# GATE_SECRET=

# ══════════════════════════════════════════════════════════════════
#  Redis 事件总线（推荐，跨进程通信）
# ══════════════════════════════════════════════════════════════════
# Docker Compose 部署时自动设为 redis://redis:6379/0
# 本地开发可改为 redis://localhost:6379/0
# 不设置则 EventBus 降级到内存模式（仅单进程有效）
# REDIS_URL=redis://localhost:6379/0

# ══════════════════════════════════════════════════════════════════
#  链上信号（可选，增强 Alpha）
# ══════════════════════════════════════════════════════════════════
# Etherscan API key（免费 5 req/sec，付费 100 req/sec）
# 获取: https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=

# Whale Alert API key（可选 backup，免费 10 req/min）
# 获取: https://whale-alert.io/
# WHALE_ALERT_API_KEY=
